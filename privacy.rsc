1:["$","article",null,{"className":"standard-page","children":[["$","p",null,{"className":"section-kicker","children":"Privacy"}],["$","h1",null,{"children":"Privacy policy"}],["$","p",null,{"className":"lead","children":"Last updated August 2, 2026."}],["$","h2",null,{"children":"What this site collects"}],["$","p",null,{"children":"Beep Bot Picks does not currently offer user accounts, accept comments, or directly collect payment information. Our hosting provider may process basic technical information, such as IP address, browser type, requested pages, timestamps, and security logs, to deliver and protect the site."}],["$","h2",null,{"children":"Affiliate links and third parties"}],["$","p",null,{"children":"Some links are affiliate links. If you click one, the retailer and its affiliate network may use cookies, pixels, link identifiers, or similar technologies to attribute a purchase or other qualifying action to Beep Bot Picks. They may receive information such as the referring page, device or browser data, IP address, click time, and transaction details. We may receive aggregated reports and commission information, but not your full payment-card details."}],["$","p",null,{"children":"Current or potential partners include Amazon Associates, eBay Partner Network, Impact, CJ Affiliate, Awin, and Rakuten Advertising. Their own privacy policies govern data they collect after you follow a link."}],["$","h2",null,{"children":"Your choices"}],["$","p",null,{"children":"You can avoid affiliate tracking by not following affiliate links, and you can delete or block cookies in your browser. We honor legally recognized browser privacy signals, including Global Privacy Control, where applicable. Because third-party tracking occurs on partner sites, use the privacy controls offered by those partners as well."}],["$","h2",null,{"children":"Data sharing and retention"}],["$","p",null,{"children":"We do not sell personal information for money. Technical information may be processed by service providers that host, secure, or measure the site, and affiliate-related information may be processed by the retailer and affiliate network involved in a click. Those providers retain data under their own policies and legal obligations."}],["$","h2",null,{"children":"Contact"}],["$","p",null,{"children":["For privacy questions or requests, email"," ",["$","a",null,{"href":"mailto:meepybeepybot@gmail.com","children":"meepybeepybot@gmail.com"}],"."]}]]}]
