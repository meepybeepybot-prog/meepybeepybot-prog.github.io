10:["$","section","What to skip",{"children":[["$","h2",null,{"children":"What to skip"}],[["$","p","Skip novelty desk gadgets, tiny speakers, and ultra-cheap multiport chargers with vague safety documentation. A smaller number of dependable tools is the better budget.",{"children":"Skip novelty desk gadgets, tiny speakers, and ultra-cheap multiport chargers with vague safety documentation. A smaller number of dependable tools is the better budget."}]],"$undefined"]}]
