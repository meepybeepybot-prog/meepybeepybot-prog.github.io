13:["$","div",null,{"className":"article-body","children":[["$","section","Start with outfit repetition",{"children":[["$","h2",null,{"children":"Start with outfit repetition"}],[["$","p","A capsule wardrobe works because a smaller group of pieces can be recombined. Accessories should follow the same rule. Before buying one, name at least three outfits you already own that it improves.",{"children":"A capsule wardrobe works because a smaller group of pieces can be recombined. Accessories should follow the same rule. Before buying one, name at least three outfits you already own that it improves."}],["$","p","If an accessory requires a new outfit to make sense, it is probably expanding the problem rather than completing the wardrobe.",{"children":"If an accessory requires a new outfit to make sense, it is probably expanding the problem rather than completing the wardrobe."}]],"$undefined"]}],["$","section","The four-part accessory filter",{"children":[["$","h2",null,{"children":"The four-part accessory filter"}],[["$","p","Use this before adding another almost-right item.",{"children":"Use this before adding another almost-right item."}]],["$","ul",null,{"children":[["$","li","Function: does it carry, secure, warm, organize, or finish an outfit you actually wear?",{"children":"Function: does it carry, secure, warm, organize, or finish an outfit you actually wear?"}],["$","li","Compatibility: does its color and hardware work with at least three existing combinations?",{"children":"Compatibility: does its color and hardware work with at least three existing combinations?"}],["$","li","Comfort: can it be worn or carried for the full occasion without constant adjustment?",{"children":"Comfort: can it be worn or carried for the full occasion without constant adjustment?"}],["$","li","Durability: are closures, stitching, lining, and high-wear edges built for regular use?",{"children":"Durability: are closures, stitching, lining, and high-wear edges built for regular use?"}]]}]]}],["$","section","A useful starting set",{"children":[["$","h2",null,{"children":"A useful starting set"}],[["$","p","A practical starting point might include one everyday bag, one dressier compact option, a belt that fits the rises you wear, and a small group of jewelry in one dominant metal tone. This is a framework, not a quota.",{"children":"A practical starting point might include one everyday bag, one dressier compact option, a belt that fits the rises you wear, and a small group of jewelry in one dominant metal tone. This is a framework, not a quota."}],["$","p","Photograph favorite outfit combinations. The pictures reveal which accessories repeat naturally and which ones only looked versatile in the store.",{"children":"Photograph favorite outfit combinations. The pictures reveal which accessories repeat naturally and which ones only looked versatile in the store."}]],"$undefined"]}]]}]
