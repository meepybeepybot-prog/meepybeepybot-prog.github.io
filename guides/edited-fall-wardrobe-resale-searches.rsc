17:["$","div",null,{"className":"article-body","children":[["$","section","Why these searches now",{"children":[["$","h2",null,{"children":"Why these searches now"}],[["$","p","Depop's official 2026 trend report describes a move away from nonstop microtrends and toward an 'edited self': repeatable silhouettes, sharper staples, and personal pieces with a history. Its marketplace data highlights growing interest in workwear jackets, peacoats, office shirts, structured blazers, kitten heels, vintage jerseys, and mixed-era styling.",{"children":"Depop's official 2026 trend report describes a move away from nonstop microtrends and toward an 'edited self': repeatable silhouettes, sharper staples, and personal pieces with a history. Its marketplace data highlights growing interest in workwear jackets, peacoats, office shirts, structured blazers, kitten heels, vintage jerseys, and mixed-era styling."}],["$","p","Pinterest results for fall outfits independently reinforce the practical side of that shift: wide-leg denim, long coats, brown neutrals, capsule wardrobes, knee-high boots, and simple outfits built around one strong layer. Those signals point to a wardrobe formula, not a shopping haul.",{"children":"Pinterest results for fall outfits independently reinforce the practical side of that shift: wide-leg denim, long coats, brown neutrals, capsule wardrobes, knee-high boots, and simple outfits built around one strong layer. Those signals point to a wardrobe formula, not a shopping haul."}]],"$undefined"]}],["$","section","The five-search fall formula",{"children":[["$","h2",null,{"children":"The five-search fall formula"}],[["$","p","Choose the searches that fill a real gap. You do not need all five.",{"children":"Choose the searches that fill a real gap. You do not need all five."}]],["$","ul",null,{"children":[["$","li","Vintage workwear jacket: look for sturdy fabric, useful pockets, intact cuffs, and measurements that allow a knit underneath.",{"children":"Vintage workwear jacket: look for sturdy fabric, useful pockets, intact cuffs, and measurements that allow a knit underneath."}],["$","li","Wool peacoat: confirm fiber content, lining condition, shoulder width, sleeve length, and whether odors or moth damage are disclosed.",{"children":"Wool peacoat: confirm fiber content, lining condition, shoulder width, sleeve length, and whether odors or moth damage are disclosed."}],["$","li","Oversized button-down: compare garment measurements to a shirt you already like; 'oversized' is not a standardized fit.",{"children":"Oversized button-down: compare garment measurements to a shirt you already like; 'oversized' is not a standardized fit."}],["$","li","Wide-leg denim: check rise, inseam, thigh measurement, fabric stretch, and the footwear you expect to wear with it.",{"children":"Wide-leg denim: check rise, inseam, thigh measurement, fabric stretch, and the footwear you expect to wear with it."}],["$","li","Vintage shoulder bag: inspect corners, strap anchors, zipper function, lining, measurements, seller photos, and any authentication claim.",{"children":"Vintage shoulder bag: inspect corners, strap anchors, zipper function, lining, measurements, seller photos, and any authentication claim."}]]}]]}],["$","section","Build one uniform before buying",{"children":[["$","h2",null,{"children":"Build one uniform before buying"}],[["$","p","Write one outfit formula using pieces you already own—for example: button-down, straight or wide-leg denim, practical jacket, low-profile shoe, and one characterful bag. Buy only the missing role, not a duplicate of the easiest piece to browse.",{"children":"Write one outfit formula using pieces you already own—for example: button-down, straight or wide-leg denim, practical jacket, low-profile shoe, and one characterful bag. Buy only the missing role, not a duplicate of the easiest piece to browse."}],"$L1a"],"$undefined"]}],"$L1b"]}]
