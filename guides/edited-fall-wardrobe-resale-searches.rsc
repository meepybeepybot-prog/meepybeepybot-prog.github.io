19:["$","section",null,{"className":"related-guides","children":[["$","p",null,{"className":"section-kicker","children":"Keep reading"}],["$","h2",null,{"children":"Related practical guides"}],["$","div",null,{"children":[["$","$L2","capsule-wardrobe-accessories-checklist",{"href":"/guides/capsule-wardrobe-accessories-checklist/","children":["The capsule-wardrobe accessory checklist: buy fewer, combine more"," ",["$","span",null,{"aria-hidden":"true","children":"→"}]]}],["$","$L2","viral-fashion-worth-the-hype-checklist",{"href":"/guides/viral-fashion-worth-the-hype-checklist/","children":["Viral fashion: the worth-the-hype checklist before you buy"," ",["$","span",null,{"aria-hidden":"true","children":"→"}]]}],["$","$L2","budget-usb-c-hub-buying-guide",{"href":"/guides/budget-usb-c-hub-buying-guide/","children":["The USB-C hub checklist that prevents a bad buy"," ",["$","span",null,{"aria-hidden":"true","children":"→"}]]}]]}]]}]
1a:["$","p","A useful item should repeat across at least three outfits. If it works only in the inspiration image, save the image and skip the purchase.",{"children":"A useful item should repeat across at least three outfits. If it works only in the inspiration image, save the image and skip the purchase."}]
1b:["$","section","How to shop resale without mistaking price for value",{"children":[["$","h2",null,{"children":"How to shop resale without mistaking price for value"}],[["$","p","Resale prices change listing by listing, so an affiliate link cannot honestly promise a private discount. Compare sold or completed listings where available, read the full condition description, and include shipping and return terms in the real cost.",{"children":"Resale prices change listing by listing, so an affiliate link cannot honestly promise a private discount. Compare sold or completed listings where available, read the full condition description, and include shipping and return terms in the real cost."}],["$","p","For branded bags and high-value pieces, treat vague provenance, stock-only photos, missing serial or construction details, and pressure to leave the marketplace as reasons to walk away.",{"children":"For branded bags and high-value pieces, treat vague provenance, stock-only photos, missing serial or construction details, and pressure to leave the marketplace as reasons to walk away."}]],"$undefined"]}]
