13:["$","div",null,{"className":"article-body","children":[["$","section","A power strip is not automatically a surge protector",{"children":[["$","h2",null,{"children":"A power strip is not automatically a surge protector"}],[["$","p","A basic strip only adds outlets. A surge protector includes components intended to limit transient voltage. Look for a recognized certification and verify the listing applies to the exact model—not merely the brand.",{"children":"A basic strip only adds outlets. A surge protector includes components intended to limit transient voltage. Look for a recognized certification and verify the listing applies to the exact model—not merely the brand."}],["$","p","For the United States, UL 1449 is the key product safety standard commonly associated with surge protective devices.",{"children":"For the United States, UL 1449 is the key product safety standard commonly associated with surge protective devices."}]],"$undefined"]}],["$","section","Specs worth checking",{"children":[["$","h2",null,{"children":"Specs worth checking"}],[["$","p","Use the specification sheet rather than the marketing headline.",{"children":"Use the specification sheet rather than the marketing headline."}]],["$","ul",null,{"children":[["$","li","Certification and exact model number.",{"children":"Certification and exact model number."}],["$","li","A protection-status light that is distinct from the ordinary power light.",{"children":"A protection-status light that is distinct from the ordinary power light."}],["$","li","Cord length and plug orientation for the actual room layout.",{"children":"Cord length and plug orientation for the actual room layout."}],["$","li","Spacing for power bricks without blocking neighboring outlets.",{"children":"Spacing for power bricks without blocking neighboring outlets."}],["$","li","USB-C output wattage if you expect it to replace a charger.",{"children":"USB-C output wattage if you expect it to replace a charger."}],["$","li","Warranty exclusions and the evidence required for any connected-equipment claim.",{"children":"Warranty exclusions and the evidence required for any connected-equipment claim."}]]}]]}],["$","section","What not to connect",{"children":[["$","h2",null,{"children":"What not to connect"}],[["$","p","Do not daisy-chain strips or run one from an extension cord. High-load appliances may require a dedicated wall outlet under their manufacturer instructions.",{"children":"Do not daisy-chain strips or run one from an extension cord. High-load appliances may require a dedicated wall outlet under their manufacturer instructions."}],["$","p","A plug-in protector is not a substitute for proper wiring, grounding, or a whole-home protection plan where severe storms are common.",{"children":"A plug-in protector is not a substitute for proper wiring, grounding, or a whole-home protection plan where severe storms are common."}]],"$undefined"]}]]}]
