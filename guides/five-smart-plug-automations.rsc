,"small",null,{"children":"Use the checklist in this guide before choosing a product."}]]}],["$","div",null,{"className":"article-body","children":[["$","section","Safety rule first",{"children":[["$","h2",null,{"children":"Safety rule first"}],[["$","p","Do not use a smart plug to control heaters, cooking appliances, medical devices, or anything that could become dangerous when unattended. Confirm the plug’s current rating and the appliance manufacturer’s guidance.",{"children":"Do not use a smart plug to control heaters, cooking appliances, medical devices, or anything that could become dangerous when unattended. Confirm the plug’s current rating and the appliance manufacturer’s guidance."}],["$","p","A smart plug should automate a safe device, not bypass its safety controls.",{"children":"A smart plug should automate a safe device, not bypass its safety controls."}]],"$undefined"]}],["$","section","The useful five",{"children":[["$","h2",null,{"children":"The useful five"}],[],["$","ul",null,{"children":[["$","li","Shut down a desk’s accessory power overnight while leaving the computer itself untouched.",{"children":"Shut down a desk’s accessory power overnight while leaving the computer itself untouched."}],["$","li","Turn decorative lights on at sunset and off at a fixed bedtime.",{"children":"Turn decorative lights on at sunset and off at a fixed bedtime."}],["$","li","Cycle a frozen router only after simpler connectivity checks fail.",{"children":"Cycle a frozen router only after simpler connectivity checks fail."}],["$","li","Cap charging time for rarely used battery-powered gear.",{"children":"Cap charging time for rarely used battery-powered gear."}],["$","li","Measure the real energy use of a suspected power hog before replacing it.",{"children":"Measure the real energy use of a suspected power hog before replacing it."}]]}]]}],["$","section","Keep a manual fallback",{"children":["$Ld",["$Le","$Lf"],"$undefined"]}]]}],"$L10","$L11"]}]
